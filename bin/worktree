#!/usr/bin/env bash

set -u
set -o pipefail

PROGRAM_NAME=${0##*/}
release_mode=0
force_release=0
base_dir=""
base_was_set=0
worktree_name=""

rollback_enabled=0
rollback_repo=""
rollback_target=""
rollback_branch=""
# What this run did to the branch: "", "creation", or "fast-forwarding".
rollback_branch_change=""
rollback_branch_start=""
rollback_branch_original_tip=""
rollback_copied_files_count=0
declare -a rollback_copied_files

usage() {
  cat <<EOF
Usage:
  $PROGRAM_NAME [OPTIONS] NAME
  $PROGRAM_NAME --release [--force]
  $PROGRAM_NAME -r [-f]

Options:
  -b, --base DIR   Base directory for new worktrees.
                   Defaults to PROJECT_WORKTREE_DIR.
  -r, --release    Remove the worktree containing the current directory.
  -f, --force      Remove it even when it has uncommitted changes.
  -h, --help       Show this help.
EOF
}

error() {
  printf '%s: error: %s\n' "$PROGRAM_NAME" "$*" >&2
}

warn() {
  printf '%s: warning: %s\n' "$PROGRAM_NAME" "$*" >&2
}

die() {
  error "$*"
  exit 1
}

usage_error() {
  error "$*"
  printf 'Try %s --help for usage.\n' "$PROGRAM_NAME" >&2
  exit 2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

canonical_directory() {
  (
    cd "$1" 2>/dev/null || exit 1
    pwd -P
  )
}

short_commit() {
  git -C "$1" rev-parse --short "$2"
}

# Prints the default branch ref: origin/HEAD, then local main, then master.
default_branch_ref() {
  local repo=$1
  local ref

  if ref=$(git -C "$repo" symbolic-ref --quiet refs/remotes/origin/HEAD) && \
    git -C "$repo" rev-parse --verify --quiet "$ref" >/dev/null; then
    printf '%s\n' "$ref"
    return
  fi
  for ref in refs/heads/main refs/heads/master; do
    if git -C "$repo" rev-parse --verify --quiet "$ref" >/dev/null; then
      printf '%s\n' "$ref"
      return
    fi
  done
}

# Prints why an existing branch behind HEAD must not be fast-forwarded, or
# nothing when moving it to HEAD is safe. ahead_count is the number of commits
# on the branch that HEAD does not contain.
fast_forward_blocker() {
  local repo=$1
  local branch=$2
  local tip=$3
  local ahead_count=$4
  local upstream
  local default_ref
  local default_name

  if ((ahead_count > 0)); then
    printf 'it has its own commits\n'
    return
  fi

  upstream=$(git -C "$repo" for-each-ref --format='%(upstream:short)' "refs/heads/$branch")
  if [[ -n "$upstream" ]]; then
    printf 'it tracks %s\n' "$upstream"
    return
  fi

  default_ref=$(default_branch_ref "$repo")
  if [[ -z "$default_ref" ]]; then
    printf 'no default branch was found\n'
    return
  fi
  if ! git -C "$repo" merge-base --is-ancestor "$tip" "$default_ref"; then
    default_name=${default_ref#refs/heads/}
    printf 'it has commits that are not in %s\n' "${default_name#refs/remotes/}"
  fi
}

set_worktree_name() {
  if [[ -n "$worktree_name" ]]; then
    usage_error "Only one NAME may be specified."
  fi
  worktree_name=$1
}

rollback_create() {
  local status=$?
  local current_branch_tip=""

  trap - EXIT

  if ((rollback_enabled)); then
    error "Creation failed; rolling back the worktree."

    if ((rollback_copied_files_count > 0)); then
      local copied_file
      for copied_file in "${rollback_copied_files[@]}"; do
        if [[ -e "$copied_file" || -L "$copied_file" ]]; then
          if ! rm -f -- "$copied_file"; then
            error "Rollback could not remove copied local config: $copied_file"
          fi
        fi
      done
    fi

    if [[ -e "$rollback_target" || -L "$rollback_target" ]]; then
      if ! git -C "$rollback_repo" worktree remove -- "$rollback_target"; then
        error "Rollback could not remove worktree: $rollback_target"
      fi
    fi

    # Put the branch back where it was (deleted for a new branch), unless
    # something else moved it after this run did.
    if [[ -n "$rollback_branch_change" ]]; then
      current_branch_tip=$(git -C "$rollback_repo" rev-parse --verify "refs/heads/$rollback_branch" 2>/dev/null || true)

      if [[ -z "$current_branch_tip" ]]; then
        if [[ -n "$rollback_branch_original_tip" ]]; then
          error "Rollback could not restore branch because it no longer exists: $rollback_branch (was $rollback_branch_original_tip)"
        fi
      elif [[ "$current_branch_tip" != "$rollback_branch_start" ]]; then
        if [[ "$current_branch_tip" != "$rollback_branch_original_tip" ]]; then
          error "Rollback retained branch because it was updated after $rollback_branch_change: $rollback_branch"
        fi
      elif [[ -z "$rollback_branch_original_tip" ]]; then
        if ! git -C "$rollback_repo" branch -D -- "$rollback_branch" >/dev/null; then
          error "Rollback could not remove branch: $rollback_branch"
        fi
      elif ! git -C "$rollback_repo" branch -f -- "$rollback_branch" "$rollback_branch_original_tip" >/dev/null; then
        error "Rollback could not restore branch $rollback_branch to $rollback_branch_original_tip"
      fi
    fi
  fi

  exit "$status"
}

copy_local_config_file() {
  local source_root=$1
  local target_root=$2
  local relative_path=$3
  local source=$source_root/$relative_path
  local destination=$target_root/$relative_path
  local destination_dir=$target_root/${relative_path%/*}

  if [[ ! -e "$source" && ! -L "$source" ]]; then
    return
  fi
  if [[ -L "$source" ]]; then
    error "Skipping symbolic-link local config: $relative_path"
    return
  fi
  if [[ ! -f "$source" ]]; then
    error "Skipping non-regular local config: $relative_path"
    return
  fi
  if [[ -e "$destination" || -L "$destination" ]]; then
    return
  fi

  mkdir -p -- "$destination_dir" || die "Could not create local config directory: $destination_dir"

  rollback_copied_files[rollback_copied_files_count]=$destination
  rollback_copied_files_count=$((rollback_copied_files_count + 1))
  cp -p "$source" "$destination" || die "Could not copy local config: $relative_path"

  printf 'Copied local config: %s\n' "$relative_path"
  if ! git -C "$target_root" check-ignore --quiet -- "$relative_path"; then
    error "Copied local config is not ignored by Git: $relative_path"
  fi
}

validate_target_components() {
  local base=$1
  local relative=$2
  local current=$base
  local component

  while [[ "$relative" == */* ]]; do
    component=${relative%%/*}
    current=$current/$component

    if [[ -L "$current" ]]; then
      die "A target path component is a symbolic link: $current"
    fi
    if [[ -e "$current" && ! -d "$current" ]]; then
      die "A target path component is not a directory: $current"
    fi

    relative=${relative#*/}
  done
}

create_worktree() {
  local repo_root
  local canonical_base
  local target
  local checked_name
  local branch_start=""
  local existing_tip=""
  local counts
  local ahead_count=0
  local behind_count=0
  local fast_forward_reason=""
  local worktree_add_error=""
  local branch_summary=""
  local branch_warning=""

  require_command git
  require_command herdr

  [[ ${HERDR_ENV:-} == 1 ]] || die "Creation must be run inside a Herdr-managed pane (HERDR_ENV=1)."
  [[ -n ${HERDR_WORKSPACE_ID:-} ]] || die "HERDR_WORKSPACE_ID is not set."

  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "Not inside a Git worktree."
  repo_root=$(canonical_directory "$repo_root") || die "Could not resolve repository path: $repo_root"
  git -C "$repo_root" rev-parse --verify HEAD >/dev/null 2>&1 || die "The repository does not have a valid HEAD."

  if ((base_was_set)); then
    [[ -n "$base_dir" ]] || usage_error "--base requires a non-empty directory."
  else
    base_dir=${PROJECT_WORKTREE_DIR:-}
    [[ -n "$base_dir" ]] || die "No worktree base directory specified; use --base or set PROJECT_WORKTREE_DIR."
  fi

  if [[ "$worktree_name" == /* ]]; then
    die "NAME must be relative, not absolute: $worktree_name"
  fi
  checked_name=$(git check-ref-format --branch "$worktree_name" 2>/dev/null) || die "Invalid branch name: $worktree_name"
  [[ "$checked_name" == "$worktree_name" ]] || die "NAME must be a literal branch name: $worktree_name"

  mkdir -p -- "$base_dir" || die "Could not create base directory: $base_dir"
  canonical_base=$(canonical_directory "$base_dir") || die "Could not resolve base directory: $base_dir"
  validate_target_components "$canonical_base" "$worktree_name"
  target=$canonical_base/$worktree_name

  if [[ -e "$target" || -L "$target" ]]; then
    die "Target path already exists: $target"
  fi

  branch_start=$(git -C "$repo_root" rev-parse HEAD) || die "Could not resolve HEAD."
  existing_tip=$(git -C "$repo_root" rev-parse --verify --quiet "refs/heads/$worktree_name") || existing_tip=""

  rollback_repo=$repo_root
  rollback_target=$target
  rollback_branch=$worktree_name
  rollback_branch_start=$branch_start

  if [[ -n "$existing_tip" ]]; then
    # Nothing has changed yet, so rollback only reverts what is recorded below.
    rollback_enabled=1
    worktree_add_error="Could not create worktree for existing branch: $worktree_name"
    counts=$(git -C "$repo_root" rev-list --left-right --count "$existing_tip...$branch_start") || \
      die "Could not compare existing branch with HEAD: $worktree_name"
    read -r ahead_count behind_count <<< "$counts"

    if ((behind_count > 0)); then
      fast_forward_reason=$(fast_forward_blocker "$repo_root" "$worktree_name" "$existing_tip" "$ahead_count")
    fi

    if ((behind_count > 0)) && [[ -z "$fast_forward_reason" ]]; then
      # The branch has no commits outside the default branch and has never been
      # pushed, so moving it to HEAD loses nothing and makes it start from the
      # same point as a newly created branch.
      rollback_branch_change=fast-forwarding
      rollback_branch_original_tip=$existing_tip
      if ! git -C "$repo_root" branch -f -- "$worktree_name" "$branch_start" >/dev/null; then
        die "Could not fast-forward existing branch: $worktree_name"
      fi
      branch_summary="Fast-forwarded existing branch: $worktree_name ($(short_commit "$repo_root" "$existing_tip") -> $(short_commit "$repo_root" "$branch_start"))"
    else
      branch_summary="Using existing branch: $worktree_name at $(short_commit "$repo_root" "$existing_tip")"
      if ((behind_count > 0)); then
        branch_warning="Existing branch $worktree_name is $behind_count commit(s) behind HEAD and was not fast-forwarded because $fast_forward_reason; rebase it if it should start from HEAD."
      fi
    fi
  else
    worktree_add_error="Could not create worktree and branch: $worktree_name"
    branch_summary="Created branch: $worktree_name from $(short_commit "$repo_root" "$branch_start")"
    if ! git -C "$repo_root" branch -- "$worktree_name" "$branch_start"; then
      die "Could not create branch: $worktree_name"
    fi
    # Enabled only after creation, so a failed "git branch" never deletes a
    # branch that someone else created concurrently.
    rollback_branch_change=creation
    rollback_enabled=1
  fi

  if ! git -C "$repo_root" worktree add "$target" "$worktree_name"; then
    die "$worktree_add_error"
  fi

  copy_local_config_file "$repo_root" "$target" ".claude/settings.local.json"
  copy_local_config_file "$repo_root" "$target" ".codex/config.toml"
  copy_local_config_file "$repo_root" "$target" ".zed/settings.json"

  if ! herdr tab create \
    --workspace "$HERDR_WORKSPACE_ID" \
    --cwd "$target" \
    --label "$worktree_name" \
    --focus >/dev/null; then
    die "Could not create the Herdr tab."
  fi

  rollback_enabled=0

  printf 'Created worktree: %s\n' "$target"
  printf '%s\n' "$branch_summary"
  printf 'Opened Herdr tab for: %s\n' "$target"
  if [[ -n "$branch_warning" ]]; then
    warn "$branch_warning"
  fi
}

release_worktree() {
  local target
  local worktree_list
  local line
  local listed_path
  local canonical_listed
  local main_worktree=""
  local registered=0
  local branch=""
  local detached_commit=""
  local detached_refs=""

  require_command git

  target=$(git rev-parse --show-toplevel 2>/dev/null) || die "Not inside a Git worktree."
  target=$(canonical_directory "$target") || die "Could not resolve current worktree path: $target"
  worktree_list=$(git -C "$target" worktree list --porcelain) || die "Could not list Git worktrees."

  while IFS= read -r line; do
    case "$line" in
      "worktree "*)
        listed_path=${line#worktree }
        canonical_listed=$(canonical_directory "$listed_path") || canonical_listed=$listed_path

        if [[ -z "$main_worktree" ]]; then
          main_worktree=$canonical_listed
        fi
        if [[ "$canonical_listed" == "$target" ]]; then
          registered=1
        fi
        ;;
    esac
  done <<< "$worktree_list"

  ((registered)) || die "Current directory is not a registered Git worktree: $target"
  [[ -n "$main_worktree" ]] || die "Could not determine the main Git worktree."
  [[ "$target" != "$main_worktree" ]] || die "Refusing to remove the main Git worktree: $target"

  if branch=$(git -C "$target" symbolic-ref --quiet --short HEAD); then
    :
  else
    branch=""
    detached_commit=$(git -C "$target" rev-parse HEAD 2>/dev/null) || \
      die "Could not resolve detached HEAD in worktree: $target"
    detached_refs=$(git -C "$target" for-each-ref --format='%(refname)' --contains "$detached_commit") || \
      die "Could not inspect references containing detached HEAD: $detached_commit"
    [[ -n "$detached_refs" ]] || \
      die "Refusing to remove a worktree whose detached HEAD is not reachable from any ref: $detached_commit"
  fi

  cd "$main_worktree" || die "Could not enter the main Git worktree: $main_worktree"
  if ((force_release)); then
    if ! git -C "$main_worktree" worktree remove --force -- "$target"; then
      die "Could not forcibly remove worktree: $target"
    fi
  elif ! git -C "$main_worktree" worktree remove -- "$target"; then
    die "Could not remove worktree: $target"
  fi

  printf 'Removed worktree: %s\n' "$target"
  if [[ -n "$branch" ]]; then
    printf 'Branch retained: %s\n' "$branch"
  elif [[ -n "$detached_commit" ]]; then
    printf 'Detached HEAD was: %s\n' "$(short_commit "$main_worktree" "$detached_commit")"
  fi
  printf 'The current shell is now inside a removed directory.\n'
  printf 'Press Control-D to close this tab, or run:\n'
  printf '  cd %q\n' "$main_worktree"
}

trap rollback_create EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

while (($# > 0)); do
  case "$1" in
    -r|--release)
      release_mode=1
      shift
      ;;
    -f|--force)
      force_release=1
      shift
      ;;
    -b|--base)
      (($# >= 2)) || usage_error "$1 requires a directory argument."
      [[ -n "$2" ]] || usage_error "$1 requires a non-empty directory argument."
      base_dir=$2
      base_was_set=1
      shift 2
      ;;
    --base=*)
      base_dir=${1#*=}
      [[ -n "$base_dir" ]] || usage_error "--base requires a non-empty directory argument."
      base_was_set=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while (($# > 0)); do
        set_worktree_name "$1"
        shift
      done
      ;;
    -*)
      usage_error "Unknown option: $1"
      ;;
    *)
      set_worktree_name "$1"
      shift
      ;;
  esac
done

if ((release_mode)); then
  ((base_was_set == 0)) || usage_error "--release cannot be combined with --base."
  [[ -z "$worktree_name" ]] || usage_error "--release does not accept NAME."
  release_worktree
else
  ((force_release == 0)) || usage_error "--force can only be used with --release."
  [[ -n "$worktree_name" ]] || usage_error "NAME is required."
  create_worktree
fi

rollback_enabled=0
